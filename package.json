{
  "name": "study-village",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "start": "python3 -m http.server 4173 --directory dist",
    "format": "npx -y prettier@3.3.3 --write \"dist/*.{js,css,html}\" \"dist/ui/*.js\" \"tests/*.mjs\" \"tests/e2e/*.mjs\" \"tools/*.mjs\" playwright.config.mjs",
    "format:check": "npx -y prettier@3.3.3 --check \"dist/*.{js,css,html}\" \"dist/ui/*.js\" \"tests/*.mjs\" \"tests/e2e/*.mjs\" \"tools/*.mjs\" playwright.config.mjs",
    "icons": "node tools/build-icons.mjs",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1"
  }
}
